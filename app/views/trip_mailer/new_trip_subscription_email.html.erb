<div
  style="background: #5e77da; color: #fff; text-align: center; border-radius: 0.5em;
    font-size: 1em; padding: 1em; font-family: system-ui, -apple-system, 'Segoe UI',
    Roboto, 'Helvetica Neue', Arial, sans-serif; width: 95%; margin: 0 auto;"
>
  <div>
    <%= email_image_tag("desktop-logo.png") %>
  </div>

  <div style="max-width: 70em; margin: 0 auto;">
    <h2 style="margin-bottom: 0.5em;">Hi <%= @follower.username %></h2>

    <p><%= @creator.username %> has posted a new trip on Footprints:</p>

    <div
      style="background: #fff; border: 1px solid #dfe3f1; border-radius: 0.75em;
        box-shadow: 0 4px 12px rgba(30, 45, 95, 0.18); color: #27304a;
        margin: 1.25em auto; max-width: 38em; padding: 1.5em; text-align: left;"
    >
      <p
        style="color: #6b7280; font-size: 0.8em; font-weight: 600; letter-spacing: 0.08em;
          margin: 0 0 0.5em; text-transform: uppercase;"
      >
        New trip
      </p>

      <h3 style="font-size: 1.4em; margin: 0 0 0.75em;">
        <%= link_to @trip.name, trip_url(@trip), style: "color: #3454d1; text-decoration: none;" %>
      </h3>

      <div style="border-top: 1px solid #e8eaf2; color: #4b5563; line-height: 1.6; padding-top: 1em;">
        <%= @trip.body %>
      </div>

      <p style="margin: 1.25em 0 0;">
        <%= link_to "View trip →", trip_url(@trip),
          style: "background: #3454d1; border-radius: 0.4em; color: #fff; display: inline-block;
            font-weight: 600; padding: 0.65em 1em; text-decoration: none;" %>
      </p>
    </div>

    <p style="font-size: 0.9em;">
      You have been automatically subscribed to updates for this trip.
      If you do not want to receive updates, open <%= link_to "the trip", trip_url(@trip), style: "color: #fff; font-weight: bold;" %>
      and select <strong>Unfollow</strong>.
    </p>
  </div>
</div>
