<%= turbo_frame_tag dom_id(@trip) do %>
  <% content_for :title, "#{@trip.name} · Footprints" %>

  <main class="container-fluid trip">
    <header class="trip-header">
      <div class="trip-header__top">
        <div class="trip-header__intro">
          <h1 class="trip-title"><%= @trip.name %></h1>

          <p class="trip-byline text-body-secondary">
            <% if @trip.user.profile_picture.attached? %>
              <%= tiny_avatar_image_tag @trip.user,
                class: "rounded-circle trip-byline__avatar",
                alt: "" %>
            <% else %>
              <i class="bi bi-person-circle trip-byline__avatar-placeholder" aria-hidden="true"></i>
            <% end %>

            <%= link_to @trip.user.username,
              user_path(username: @trip.user.username),
              class: "text__link",
              data: { turbo_frame: "_top" } %>
            <span class="desktop-only">started this trip on</span>
            <time datetime="<%= @trip.created_at&.to_date&.iso8601 %>">
              <%= @trip.created_at&.strftime("%B %d, %Y") %>
            </time>
          </p>
        </div>

        <div class="trip-header__actions">
          <% if @trip.companions.any? %>
            <div class="dropdown">
              <button
                class="btn btn-outline-secondary trip-icon-button"
                id="trip-companions"
                type="button"
                aria-expanded="false"
                data-bs-toggle="dropdown"
                data-bs-display="static"
                aria-label="View trip companions"
              >
                <i class="bi bi-people" aria-hidden="true"></i>
              </button>

              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="trip-companions">
                <% @trip.companions.each do |companion| %>
                  <li>
                    <%= link_to user_path(username: companion.user.username),
                      class: "dropdown-item d-flex align-items-center gap-2",
                      data: { turbo_frame: "_top" } do %>
                      <% if companion.user.profile_picture.attached? %>
                        <%= tiny_avatar_image_tag companion.user,
                          class: "rounded-circle trip-byline__avatar",
                          alt: "" %>
                      <% else %>
                        <i class="bi bi-person-circle trip-byline__avatar-placeholder" aria-hidden="true"></i>
                      <% end %>
                      <%= companion.user.username %>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <% if Current.user %>
            <% if @trip.followed_by?(Current.user) %>
              <%= button_to trip_trip_follower_path(@trip.id, @trip.followers.find_by(user: Current.user).id),
                class: "btn btn-danger d-flex align-items-center gap-2",
                data: { turbo_confirm: "By unfollowing this trip you will no longer receive emails when new posts are added." },
                method: :delete do %>
                <i class="bi bi-envelope-x-fill" aria-hidden="true"></i>
                Unfollow
              <% end %>
            <% else %>
              <%= button_to trip_trip_followers_path(trip_id: @trip.id),
                class: "btn btn-primary d-flex align-items-center gap-2",
                data: { turbo_confirm: "By following this trip you will receive emails when new posts are added." } do %>
                <i class="bi bi-envelope-plus-fill" aria-hidden="true"></i>
                Follow
              <% end %>
            <% end %>
          <% else %>
            <p class="trip-follow-prompt text-body-secondary">
              <%= link_to "Log in", new_session_path, data: { turbo_frame: "_top" } %> to follow
            </p>
          <% end %>

          <% if Current.user == @trip.user %>
            <div class="dropdown">
              <button
                class="btn btn-outline-secondary trip-icon-button"
                id="trip-actions"
                type="button"
                aria-expanded="false"
                data-bs-toggle="dropdown"
                data-bs-display="static"
                aria-label="Edit trip"
              >
                <i class="bi bi-three-dots" aria-hidden="true"></i>
              </button>

              <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="trip-actions">
                <li>
                  <%= link_to "Edit trip",
                    edit_trip_path(@trip),
                    data: { turbo: false },
                    class: "dropdown-item" %>
                </li>
                <li>
                  <%= button_to "Delete trip",
                    @trip,
                    method: :delete,
                    data: { turbo: "false" },
                    form: { data: { "turbo-confirm": "Are you sure?" } },
                    class: "dropdown-item dropdown-item--danger" %>
                </li>
              </ul>
            </div>
          <% end %>
        </div>
      </div>

      <div class="trip-description">
        <%= @trip.body %>
      </div>
    </header>

    <section class="trip-content" aria-labelledby="trip-posts-heading">
      <div class="trip-toolbar">
        <div class="trip-toolbar__top">
          <div class="d-flex align-items-center gap-2">
            <h2 class="mb-0" id="trip-posts-heading">Posts</h2>
            <span class="badge rounded-pill bg-primary" aria-label="<%= pluralize(@trip.visible_posts.count, "post") %>">
              <%= @trip.visible_posts.count %>
            </span>
          </div>

          <% if Current.user == @trip.user || Current.user&.companion_trips&.include?(@trip) %>
            <%= link_to "Create new post",
              new_post_path(trip_id: @trip.id),
              class: "btn btn-success",
              data: { turbo: false } %>
          <% end %>
        </div>

        <div class="trip-toolbar__filters" data-controller="filter">
          <%= render partial: "trips/search_and_filter" %>
          <div
            class="d-flex flex-wrap align-items-center gap-2"
            data-filter-target="filterContainerDesktop filterContainerMobile"
          ></div>
        </div>

        <% if @pagy.pages > 1 %>
          <div class="d-flex w-100 justify-content-center">
            <%== posts_pagination_nav(@pagy) %>
          </div>
        <% end %>
      </div>

      <div class="trip-feed-layout" data-controller="map">
        <div class="trip-posts">
          <%= turbo_frame_tag Post.new %>
          <%= turbo_stream_from @trip %>

          <div class="d-flex flex-column gap-4">
            <%= turbo_frame_tag "posts" do %>
              <% @posts.each do |post| %>
                <%= render "posts/post", post: post, heading_tag: :h3 %>
              <% end %>

              <% if @posts.none? %>
                <div class="d-flex justify-content-center w-100">
                  <%= render "posts/empty_state", locals: { trip: @trip } %>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>

        <% if @trip.visible_posts.with_location.any? %>
          <div
            class="rounded-3 bg-white shadow-sm trip-map"
            data-map-target="map"
            id="posts-map"
            data-points="<%= generated_points(@trip, @pagy) %>"
            data-images='<%= raw({
              bus: { left: asset_path("bus-left.webp"), right: asset_path("bus-right.webp") },
              boat: { left: asset_path("boat-left.webp"), right: asset_path("boat-right.webp") },
              plane: { left: asset_path("plane-left.webp"), right: asset_path("plane-right.webp") },
              walking: { left: asset_path("walking-left.webp"), right: asset_path("walking-right.webp") },
              rickshaw: { left: asset_path("rickshaw-left.webp"), right: asset_path("rickshaw-right.webp") },
              car: { left: asset_path("car-left.webp"), right: asset_path("car-right.webp") },
              nina: { left: asset_path("nina-left.webp"), right: asset_path("nina-right.webp") },
              motorbike: { left: asset_path("motorbike-left.webp"), right: asset_path("motorbike-right.webp") },
              train: { left: asset_path("train-left.webp"), right: asset_path("train-right.webp") }
            }.to_json) %>'
          ></div>
        <% end %>
      </div>

      <% if @pagy.pages > 1 %>
        <div class="d-flex w-100 justify-content-center my-5">
          <%== posts_pagination_nav(@pagy) %>
        </div>
      <% end %>
    </section>
  </main>
<% end %>
