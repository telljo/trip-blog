<% content_for :title, "Trips · Footprints" %>

<main class="trips-index">
  <header class="trips-index__header">
    <div>
      <p class="trips-index__eyebrow">Explore</p>
      <h1 class="trips-index__title">Trips</h1>
      <p class="trips-index__lede text-body-secondary">
        Follow the latest stories, places, and moments from every journey.
      </p>
    </div>

    <% if Current.user %>
      <%= link_to "Create a trip",
        new_trip_path,
        class: "btn btn-success",
        data: { turbo: false } %>
    <% else %>
      <%= link_to "Sign up to create a trip",
        sign_up_path,
        class: "btn btn-success",
        data: { turbo_frame: "_top" } %>
    <% end %>
  </header>

  <% if @trips.none? %>
    <%= render partial: "trips/empty_state", locals: {
      message: "There are no trips yet."
    } %>
  <% end %>

  <%= turbo_stream_from @trips if @trips.any? %>

  <%= turbo_frame_tag "trips" do %>
    <div id="trip-previews" class="trips-index__list">
      <% @trips.each do |trip| %>
        <%= render "trips/trip_preview_card",
          trip: trip,
          preview_posts: @trip_preview_posts.fetch(trip),
          post_count: @trip_post_counts.fetch(trip.id, 0) %>
      <% end %>
    </div>
  <% end %>
</main>
