<%= form_with model: user, url: user.persisted? ? user_path(user.username) : users_path, local: true do |form| %>
  <div class="mb-3">
    <label for="username" class="form-label">Username</label>
    <%= form.text_field :username, class: "form-control", id: "username" %>
  </div>
  <label for="formFile" class="form-label">Profile picture</label>
  <div
    class="profile-picture-picker py-2"
    data-controller="crop"
  >
    <div class="profile-picture-picker__preview">
      <% if @user.profile_picture.attached? %>
        <%= image_tag @user.image_as_thumbnail, id: "imagePreview", alt: "", class: "profile-picture-picker__image rounded-circle", height: 200, width: 200, data: { crop_target: "imagePreview" } %>
      <% else %>
        <img
          id="imagePreview"
          class="profile-picture-picker__image image-preview"
          data-crop-target="imagePreview"
          alt=""
          height="200"
          src="<%= asset_path('person-circle.svg') %>"
          width="200"
        />
      <% end %>
    </div>
    <div class="profile-picture-picker__controls">
      <%= form.file_field :profile_picture, accept: 'image/png,image/jpeg', class: "form-control", id: "formFile", data: { action: "change->crop#selectImage", crop_target: "fileInput" } %>
    </div>
    <%= form.hidden_field :cropped_image_data, id: "croppedImageData", data: { crop_target: "croppedImageData" } %>
  </div>
  <%= form.submit "Update", class: "btn btn-success" %>
<% end %>
