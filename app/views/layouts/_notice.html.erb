<% visible_flashes = flash.to_hash.select { |_, message| message.present? } %>
<% if visible_flashes.any? %>
  <div
    class="position-fixed start-50 translate-middle-x px-3 w-100"
    style="top: 5.5rem; z-index: 1080; max-width: 42rem;"
  >
    <% visible_flashes.each do |type, message| %>
      <% alert_class = case type.to_sym
      when :notice
        "alert-success"
      when :alert
        "alert-danger"
      else
        "alert-info"
      end %>

      <div
        class="alert <%= alert_class %> alert-dismissible fade show shadow-sm mb-2"
        role="alert"
        data-controller="notice"
      >
        <%= message %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
      </div>
    <% end %>
  </div>
<% end %>
